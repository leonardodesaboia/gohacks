# Copie para .env. Nunca commite o .env.
ANTHROPIC_API_KEY=
SENTINELA_MODEL=claude-sonnet-5-5
# GPT, ou provedor compatível com a API de chat completions da OpenAI (ex.: gateway interno): defina a chave
# e, se não for a OpenAI, a URL base. O modelo vem de SENTINELA_MODEL_OPENAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=
SENTINELA_MODEL_OPENAI=gpt-4o
# mock = determinístico, sem rede (testes e fallback) | claude | openai = extrator real por LLM
SENTINELA_EXTRATOR=mock
# replay = CSVs locais com relógio simulado | api = API do evento (se existir)
SENTINELA_MODO=replay
SENTINELA_AGORA=2026-11-02T08:00:00
SENTINELA_DB=data/sentinela.db
SENTINELA_DATA_DIR=data/raw

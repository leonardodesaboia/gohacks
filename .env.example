# Copie para .env. Nunca commite o .env.
ANTHROPIC_API_KEY=
SENTINELA_MODEL=claude-sonnet-5-5
# mock = determinístico, sem rede (testes e fallback) | claude = extrator real
SENTINELA_EXTRATOR=mock
# replay = CSVs locais com relógio simulado | api = API do evento (se existir)
SENTINELA_MODO=replay
SENTINELA_AGORA=2026-11-02T08:00:00
SENTINELA_DB=data/sentinela.db
SENTINELA_DATA_DIR=data/raw
